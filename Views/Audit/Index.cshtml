@model IEnumerable<AuditLog>
@{ViewData["Title"]="Audit Log";}<h1 class="page-title mb-3">Audit Log</h1><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search action, module, user ID"/><button class="btn btn-outline-primary">Search</button></form><div class="card p-2 table-responsive"><table class="table table-hover"><thead><tr><th>Date (UTC)</th><th>User ID</th><th>Action</th><th>Module</th><th>Record</th><th>Details</th><th>IP</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@x.UserId</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.OldValue → @x.NewValue</td><td>@x.IpAddress</td></tr>}</tbody></table></div>
