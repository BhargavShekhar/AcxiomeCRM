@model IEnumerable<Customer>
@{ViewData["Title"]="Customers";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title">Customers</h1><a class="btn btn-primary" asp-action="Create">+ New Customer</a></div><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name, email, phone, company"/><button class="btn btn-outline-primary">Search</button></form><div class="card p-2"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>CustomerCode</th><th>CustomerName</th><th>Email</th><th>Phone</th><th>CompanyName</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CustomerCode</td><td>@item.CustomerName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.CompanyName</td><td>@item.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a> <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Confirm this action?')"><button class="btn btn-sm btn-outline-danger">Close/Deactivate</button></form></td></tr>}</tbody></table></div></div>
