@model IEnumerable<FollowUp>
@{ViewData["Title"]="FollowUps";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title">FollowUps</h1><a class="btn btn-primary" asp-action="Create">+ New FollowUp</a></div><form method="get" class="d-flex gap-2 mb-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in new[]{"Planned","Completed","Missed","Cancelled"}){<option selected="@(ViewBag.Status==s)" value="@s">@s</option>}</select><button class="btn btn-outline-primary">Filter</button></form><div class="card p-2"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Subject</th><th>FollowUpDate</th><th>FollowUpType</th><th>Status</th><th>AssignedTo</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Subject</td><td>@item.FollowUpDate</td><td>@item.FollowUpType</td><td>@item.Status</td><td>@item.AssignedTo</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.FollowUpId">Edit</a> <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success">Complete</button></form></td></tr>}</tbody></table></div></div>
