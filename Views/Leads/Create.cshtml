@model Lead
@{ViewData["Title"]="Create Lead";}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><h1 class="page-title">Create Lead</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" type="text" class="form-control"/><span asp-validation-for="LeadName" class="text-danger"></span></div><div class="mb-3"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" type="text" class="form-control"/><span asp-validation-for="CompanyName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select"><option>Website</option><option>Referral</option><option>Campaign</option><option>Cold Call</option><option>Other</option></select><span asp-validation-for="Source" class="text-danger"></span></div><div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select><span asp-validation-for="Status" class="text-danger"></span></div><div class="mb-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Normal</option><option>High</option></select></div><div class="mb-3"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" type="number" class="form-control" step="0.01"/><span asp-validation-for="ExpectedValue" class="text-danger"></span></div><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a></form></div></div></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
