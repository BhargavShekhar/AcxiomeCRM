@model IEnumerable<Lead>
@{ViewData["Title"]="Leads";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title">Leads</h1><a class="btn btn-primary" asp-action="Create">+ New Lead</a></div><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search lead or company"/><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in new[]{"New","Contacted","Qualified","Unqualified","Converted","Lost"}){<option selected="@(ViewBag.Status==s)" value="@s">@s</option>}</select><button class="btn btn-outline-primary">Filter</button></form><div class="card p-2"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>LeadCode</th><th>LeadName</th><th>CompanyName</th><th>Source</th><th>Status</th><th>ExpectedValue</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.LeadCode</td><td>@item.LeadName</td><td>@item.CompanyName</td><td>@item.Source</td><td>@item.Status</td><td>@item.ExpectedValue</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.LeadId">Edit</a> <form asp-action="Delete" asp-route-id="@item.LeadId" method="post" class="d-inline" onsubmit="return confirm('Confirm this action?')"><button class="btn btn-sm btn-outline-danger">Close/Deactivate</button></form></td></tr>}</tbody></table></div></div>
