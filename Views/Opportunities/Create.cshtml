@model Opportunity
@{ViewData["Title"]="Create Opportunity";}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><h1 class="page-title">Create Opportunity</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" type="text" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="mb-3"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" type="number" class="form-control"/><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="mb-3"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" type="number" class="form-control"/><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" class="form-control" step="0.01"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="mb-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" type="number" class="form-control" step="1"/><span asp-validation-for="Probability" class="text-danger"></span></div><div class="mb-3"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><span asp-validation-for="Stage" class="text-danger"></span></div><div class="mb-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Closed</option></select><span asp-validation-for="Status" class="text-danger"></span></div><div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a></form></div></div></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
