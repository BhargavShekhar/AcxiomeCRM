@model IEnumerable<Opportunity>
@{ViewData["Title"]="Opportunities";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title">Opportunities</h1><a class="btn btn-primary" asp-action="Create">+ New Opportunity</a></div><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search opportunity"/><select name="stage" class="form-select"><option value="">All stages</option>@foreach(var s in new[]{"Qualification","Proposal","Negotiation","Won","Lost"}){<option selected="@(ViewBag.Stage==s)" value="@s">@s</option>}</select><button class="btn btn-outline-primary">Filter</button></form><div class="card p-2"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>OpportunityName</th><th>Amount</th><th>Probability</th><th>Stage</th><th>ExpectedCloseDate</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.OpportunityName</td><td>@item.Amount</td><td>@item.Probability</td><td>@item.Stage</td><td>@item.ExpectedCloseDate</td><td>@item.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OpportunityId">Edit</a> <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Confirm this action?')"><button class="btn btn-sm btn-outline-danger">Close/Deactivate</button></form></td></tr>}</tbody></table></div></div>
