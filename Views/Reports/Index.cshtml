@{ ViewData["Title"] = "Reports"; }

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">CRM Reports</h1>
    <p class="text-muted mb-0">Sales and pipeline performance for the selected period.</p>
  </div>
</div>

<form method="get" class="card p-3 mb-4">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label">From</label>
      <input type="date" name="from" value="@ViewBag.DateFrom" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">To</label>
      <input type="date" name="to" value="@ViewBag.DateTo" class="form-control" />
    </div>
    <div class="col-md-4">
      <button type="submit" class="btn btn-primary w-100">Apply Range</button>
    </div>
  </div>
</form>

<div class="alert alert-light border mb-4">
  <strong>Range:</strong> @ViewBag.RangeLabel
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Customers</div><div class="metric">@ViewBag.TotalCustomers</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Leads</div><div class="metric">@ViewBag.TotalLeads</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Qualified</div><div class="metric">@ViewBag.QualifiedLeads</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Converted</div><div class="metric">@ViewBag.ConvertedLeads</div></div></div>

  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Pipeline</div><div class="metric">@(((decimal)ViewBag.PipelineValue).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Won Revenue</div><div class="metric">@(((decimal)ViewBag.WonRevenue).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Conversion Rate</div><div class="metric">@(((decimal)ViewBag.ConversionRate).ToString("0.##"))%</div></div></div>
  <div class="col-6 col-xl-3"><div class="card dashboard-stat-card p-3 h-100"><div class="muted-label">Win Rate</div><div class="metric">@(((decimal)ViewBag.WinRate).ToString("0.##"))%</div></div></div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card dashboard-chart-card p-3 h-100">
      <h5 class="dashboard-card-title">Lead Funnel</h5>
      <div class="chart-panel"><canvas id="leadReportChart" class="dashboard-chart"></canvas></div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card dashboard-chart-card p-3 h-100">
      <h5 class="dashboard-card-title">Opportunity Stage Distribution</h5>
      <div class="chart-panel"><canvas id="stageReportChart" class="dashboard-chart"></canvas></div>
    </div>
  </div>
  <div class="col-12">
    <div class="card dashboard-chart-card p-3 h-100">
      <h5 class="dashboard-card-title">Monthly Won Revenue</h5>
      <div class="chart-panel chart-panel--wide"><canvas id="monthlyReportChart" class="dashboard-chart"></canvas></div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card p-3 h-100">
      <h5>Follow-up health</h5>
      <ul class="mb-0 ps-3">
        <li>Upcoming follow-ups (7 days): @ViewBag.UpcomingFollowUps</li>
        <li>Overdue follow-ups: @ViewBag.OverdueFollowUps</li>
        <li>New leads: @ViewBag.NewLeads</li>
        <li>Lost leads: @ViewBag.LostLeads</li>
      </ul>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-3 h-100">
      <h5>Summary</h5>
      <ul class="mb-0 ps-3">
        <li>Open opportunities: @ViewBag.OpenOpportunities</li>
        <li>Won opportunities: @ViewBag.WonOpportunities</li>
        <li>Lost opportunities: @ViewBag.LostOpportunities</li>
        <li>Average won deal: @(((decimal)ViewBag.AverageDeal).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</li>
      </ul>
    </div>
  </div>
</div>

<div class="card p-3">
  <h5 class="dashboard-card-title">Top sales performers</h5>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Owner</th>
          <th>Leads</th>
          <th>Opportunities</th>
          <th>Pipeline</th>
          <th>Won Revenue</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var row in (System.Collections.Generic.IEnumerable<(string Name, int LeadCount, int OpportunityCount, decimal PipelineValue, decimal WonRevenue)>)ViewBag.PerformanceRows)
        {
          <tr>
            <td>@row.Name</td>
            <td>@row.LeadCount</td>
            <td>@row.OpportunityCount</td>
            <td>@(row.PipelineValue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</td>
            <td>@(row.WonRevenue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script>
const commonChartOptions = {
  responsive: true,
  maintainAspectRatio: false,
  animation: { duration: 250 },
  interaction: { intersect: false, mode: 'nearest' },
  plugins: { legend: { labels: { usePointStyle: true, boxWidth: 8 } } }
};

new Chart(document.getElementById('leadReportChart'), {
  type: 'doughnut',
  data: {
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string[])ViewBag.LeadStatusLabels)),
    datasets: [{
      data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((int[])ViewBag.LeadStatusValues)),
      backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#6f42c1', '#dc3545'],
      borderWidth: 0
    }]
  },
  options: {
    ...commonChartOptions,
    plugins: { ...commonChartOptions.plugins, legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } }
  }
});

new Chart(document.getElementById('stageReportChart'), {
  type: 'bar',
  data: {
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string[])ViewBag.StageLabels)),
    datasets: [{
      label: 'Opportunities',
      data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((int[])ViewBag.StageValues)),
      backgroundColor: ['#0d6efd', '#6f42c1', '#20c997', '#198754', '#dc3545'],
      borderRadius: 6
    }]
  },
  options: {
    ...commonChartOptions,
    scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(148, 163, 184, 0.12)' } }, x: { grid: { display: false } } }
  }
});

new Chart(document.getElementById('monthlyReportChart'), {
  type: 'line',
  data: {
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string[])ViewBag.MonthLabels)),
    datasets: [{
      label: 'Won revenue',
      data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((double[])ViewBag.MonthValues)),
      borderColor: '#0d6efd',
      backgroundColor: 'rgba(13,110,253,0.15)',
      fill: true,
      tension: 0.35,
      borderWidth: 2.5,
      pointRadius: 3,
      pointHoverRadius: 5
    }]
  },
  options: {
    ...commonChartOptions,
    plugins: { ...commonChartOptions.plugins, legend: { display: false } },
    scales: { y: { beginAtZero: true, ticks: { callback: (value) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(value) }, grid: { color: 'rgba(148, 163, 184, 0.12)' } }, x: { grid: { display: false } } }
  }
});
</script>
}

