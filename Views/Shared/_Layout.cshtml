<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - AcxiomCRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-primary"><div class="container-fluid"><a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">AcxiomCRM</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li><li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li><li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li><li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li><li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li><li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>@if(User.IsInRole("Admin")){<li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Log</a></li><li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>}</ul><ul class="navbar-nav"><li class="nav-item"><span class="nav-link">@User.Identity?.Name</span></li>@if(User.Identity?.IsAuthenticated ?? false){<li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light mt-1">Logout</button></form></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>}</ul></div></div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@RenderBody()</main><footer class="text-center text-muted py-3">AcxiomCRM · Customer Relationship Management</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
