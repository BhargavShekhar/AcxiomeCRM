@model IEnumerable<ApplicationUser>
@{ViewData["Title"]="Users";}<h1 class="page-title mb-3">User & Role Management</h1><div class="card p-2 table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Lockout</th><th>Role</th><th>Actions</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@(u.IsActive?"Active":"Inactive")</td><td>@(u.LockoutEnd.HasValue&&u.LockoutEnd>DateTimeOffset.UtcNow?"Locked":"—")</td><td><form asp-action="SetRole" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@u.Id"/><select name="role" class="form-select form-select-sm"><option>SalesExecutive</option><option>Manager</option><option>Admin</option></select><button class="btn btn-sm btn-outline-primary">Set role</button></form></td><td><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-danger">@(u.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div>
